# Copy to .env for local development (never commit .env).

# Postgres for development (matches docker-compose.yml).
DATABASE_URL=postgresql+psycopg://care:care@localhost:5432/care

# Session-signing / crypto secret (generate a random value in real environments).
# Outside APP_ENV=dev the app refuses to start without a real value.
SECRET_KEY=dev-only-change-me

# Development must be opted into explicitly. APP_ENV defaults to "production",
# so a variable someone forgot to set cannot silently relax cookie flags, accept
# a placeholder SECRET_KEY, enable the tenant host fallback, or point emailed
# links at localhost.
APP_ENV=dev

# Tenant resolution. Requests map to a tenant by host subdomain:
# acme.example.com -> tenant slug "acme". Local dev has no subdomains, so the
# default slug stands in.
TENANT_HOST_SUFFIX=
DEV_DEFAULT_TENANT_SLUG=demo

# Session timeouts. Idle ends an unattended browser; absolute bounds how long a
# stolen token stays useful.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Origin for emailed invitation and password-reset links. Built from
# TENANT_HOST_SUFFIX and the tenant slug in real environments; this value is the
# dev stand-in. Never derived from the request Host header — that would let a
# forged Host point a victim's reset link at an attacker.
DEV_BASE_URL=http://localhost:8000

# Failed-login throttling, per (tenant, email).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
