# Copy to .env for local development (never commit .env).

# Postgres for development (matches docker-compose.yml).
DATABASE_URL=postgresql+psycopg://care:care@localhost:5432/care

# Session-signing / crypto secret (generate a random value in real environments).
# Outside APP_ENV=dev the app refuses to start without a real value.
SECRET_KEY=dev-only-change-me

# "dev" relaxes two things: cookies are not marked Secure (no local TLS), and
# tenant resolution falls back to DEV_DEFAULT_TENANT_SLUG. Anything else is
# treated as a real environment and fails closed.
APP_ENV=dev

# Tenant resolution. Requests map to a tenant by host subdomain:
# acme.example.com -> tenant slug "acme". Local dev has no subdomains, so the
# default slug stands in.
TENANT_HOST_SUFFIX=
DEV_DEFAULT_TENANT_SLUG=demo

# Session timeouts. Idle ends an unattended browser; absolute bounds how long a
# stolen token stays useful.
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Failed-login throttling, per (tenant, email).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
